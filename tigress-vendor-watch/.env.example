# TIGRESS Vendor Watch — environment template.
# Copy to `.env` (gitignored, NEVER commit the real file) and fill in.
# Load it into your shell before running, e.g.:  set -a; . ./.env; set +a

# SEC EDGAR requires a descriptive User-Agent with real contact info.
EDGAR_UA="TIGRESS Vendor Watch research you@yourdomain.com"

# Have I Been Pwned — subscribed API key. WITHOUT it, hibp.py still runs the
# PUBLIC breaches?domain layer; WITH it, you also get stealer-log + breacheddomain.
HIBP_API_KEY=""
# Optional separate UA for HIBP (defaults to EDGAR_UA if unset).
# HIBP_UA="TIGRESS Vendor Watch research you@yourdomain.com"

# Local synthesis model (Ollama). synthesize.py falls back to a deterministic
# template if this host is unreachable, so these are optional.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
